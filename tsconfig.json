{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["photoshop", "@adobe/cc-ext-uxp-types"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "sourceMap": true,
    "paths": {
      "@core": ["./src/core"],
      "@pptx": ["./src/pptx"],
      "@photoshop": ["./src/photoshop"],
      "@platform": ["./src/platform"],
      "@ui": ["./src/ui"],
      "@shared": ["./src/shared"]
    }
  },
  "include": ["src", "tests"]
}
