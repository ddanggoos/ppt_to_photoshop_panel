{
  "manifestVersion": 5,
  "id": "com.ddanggoos.ppt-to-photoshop",
  "name": "PPT to Photoshop",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0"
  },
  "featureFlags": {
    "enableSWCSupport": true
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pptPanel",
      "label": {
        "default": "PPT to Photoshop"
      },
      "minimumSize": { "width": 240, "height": 240 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 400 },
      "preferredFloatingSize": { "width": 320, "height": 480 }
    }
  ]
}
